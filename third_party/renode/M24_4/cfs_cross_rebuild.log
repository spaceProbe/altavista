=== [6/8] make rtems_zynqmp.prep ===
rm -f "build-rtems_zynqmp/stamp.prep"
env  make --no-print-directory -f /workspace/third_party/cfs/target-rules.mk \
	CFG=rtems_zynqmp GOAL=rtems_zynqmp.prep STAMPFILE=build-rtems_zynqmp/stamp.prep all
mkdir -p "build-rtems_zynqmp"
